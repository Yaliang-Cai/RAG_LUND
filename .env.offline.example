# ===================================================
# 离线部署 .env 模板 - 仅包含 neo4j-milvus branch 新增配置
#
# 说明：
# - constants.py 中已有的配置，此文件不重复定义
# - 只定义本 branch 额外引入的参数
# - 其他配置自动从 constants.py 读取
# ===================================================

# =========================================================================
# V2: 同义词链接 (Synonym Linking)
# =========================================================================

# 启用 V2 同义词边构建（ingestion 阶段）
ENABLE_SYNONYM_LINKING=false

# 同义词检测的 cosine similarity 阈值 (对齐 HippoRAG2: 0.8)
SYNONYMY_THRESHOLD=0.8

# 同义词检测时的 KNN topK (对齐 HippoRAG2: 100)
SYNONYMY_TOPK=100

# 同义词检测：过滤的最小实体名长度（排除短实体）
SYNONYMY_MIN_ENTITY_LEN=2

# =========================================================================
# V3: PPR 多跳推理 (PPR Multi-hop Reasoning)
# =========================================================================

# 启用 V3 多跳推理（retrieval 阶段）
ENABLE_MULTI_HOP=false

# PPR 子图提取深度
MULTI_HOP_DEPTH=2

# PPR damping 因子 (alpha)
PPR_DAMPING=0.5

# PPR 返回的 top-K chunk 数量
PPR_TOP_K=50

# HippoRAG2 参数：DPR chunk 分数在 PPR seed 中的缩放系数
PASSAGE_NODE_WEIGHT=0.05
