# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Milvus Configuration (Milvus Lite - local file, no server needed)
# MILVUS_URI is intentionally NOT set here so pymilvus does not parse it at import time.
# milvus_impl.py falls back to working_dir/milvus_lite.db when MILVUS_URI is unset.
# Requires: pip install milvus-lite
# MILVUS_URI=./milvus_lite.db
MILVUS_DB_NAME=lightrag

# Storage Backend Selection
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
