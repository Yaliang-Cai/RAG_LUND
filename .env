# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=   # 本地无认证时留空

# Qdrant 调优选项（均有默认值，按需解注释）
# QDRANT_DISTANCE=COSINE              # 距离函数: COSINE / DOT / EUCLID / MANHATTAN
# QDRANT_HNSW_M=16                    # HNSW 每节点链接数，越大召回率越高但占更多内存 (默认16)
# QDRANT_HNSW_EF_CONSTRUCT=100        # HNSW 构建质量，越大索引越准但构建越慢 (默认100)
# QDRANT_HNSW_ON_DISK=false           # HNSW 索引存磁盘以节省 RAM
# QDRANT_SEARCH_EF=128                # 查询精度/速度权衡，越大越准越慢 (不设则用 Qdrant 默认)
# QDRANT_QUANTIZATION=none            # 向量量化压缩: none / scalar(INT8,4x) / binary(32x)
# QDRANT_PREFER_GRPC=false            # 用 gRPC 代替 REST，高吞吐写入时有性能提升
# QDRANT_INDEX_RELATION_FIELDS=false  # 给 src_id/tgt_id 建关键字索引，加速关系删除查询

