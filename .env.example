# =============================================================================
# 使用方法: cp .env.example .env  然后填入实际值
# =============================================================================

# =============================================================================
# Neo4j
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# =============================================================================
# Qdrant
# =============================================================================
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                        # 本地无认证时留空

# 调优选项（均有默认值，按需解注释）
# QDRANT_DISTANCE=COSINE                 # 距离函数: COSINE / DOT / EUCLID / MANHATTAN
QDRANT_HNSW_M=16                        # HNSW 每节点链接数，越大召回率越高但内存更多
# QDRANT_HNSW_EF_CONSTRUCT=100           # HNSW 构建质量，越大越准但构建越慢
# QDRANT_HNSW_ON_DISK=false              # HNSW 索引存磁盘以节省 RAM
QDRANT_SEARCH_EF=256                    # 查询精度/速度权衡（不设则用 Qdrant 默认）
# QDRANT_QUANTIZATION=none               # 向量量化: none / scalar(INT8,4x) / binary(32x)
# QDRANT_PREFER_GRPC=false               # 用 gRPC 代替 REST，高吞吐写入时有性能提升
# QDRANT_INDEX_RELATION_FIELDS=false     # 给 src_id/tgt_id 建关键字索引，加速关系删除

# =============================================================================
# WebUI / Server
# =============================================================================
RAGANYTHING_API_KEY=your_api_key         # WebUI 登录密钥，必填

# RAGANYTHING_WORKDIR_ROOT=./rag_workspace   # KV 存储根目录
# RAGANYTHING_OUTPUT_DIR=./output            # 解析产物输出目录
# RAGANYTHING_UPLOADS_DIR=./uploads          # 上传文件存储目录
# RAGANYTHING_LOG_DIR=./logs                 # 日志目录

# =============================================================================
# LLM / vLLM
# =============================================================================
VLLM_API_BASE=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
LLM_MODEL_NAME=your_llm_model_name

# 视觉模型（不设则与 LLM 共用同一端点）
# VISION_VLLM_API_BASE=http://localhost:8002/v1
# VISION_VLLM_API_KEY=EMPTY
# VISION_MODEL_NAME=your_vision_model_name

# =============================================================================
# 本地模型路径
# =============================================================================
RAGANYTHING_EMBEDDING_MODEL_PATH=/path/to/bge-m3
RAGANYTHING_RERANK_MODEL_PATH=/path/to/bge-reranker-v2-m3
VISION_MODEL_PATH=/path/to/vision_model
# TIKTOKEN_CACHE_DIR=/path/to/tiktoken_cache

# =============================================================================
# 推理 / Chunking 参数（均有默认值，按需修改）
# =============================================================================
# RAGANYTHING_DEVICE=cuda:0
# RAGANYTHING_EMBEDDING_DIM=1024
# RAGANYTHING_TEMPERATURE=0.0
# RAGANYTHING_QUERY_MAX_TOKENS=2048
# RAGANYTHING_INGEST_MAX_TOKENS=8192
# CHUNK_SIZE=1200
# CHUNK_OVERLAP_SIZE=100
# CHUNKING_STRATEGY=token               # token / recursive / sentence / paragraph / semantic

# =============================================================================
# Entity Surface Normalization & Relation Endpoint Strict Match (optional)
# =============================================================================
# RAGANYTHING_ENABLE_ENTITY_SURFACE_NORMALIZATION=true
# RAGANYTHING_ENABLE_KEYWORD_CASE_NORMALIZATION=true
# RAGANYTHING_ENTITY_UPPERCASE_ALLOWLIST=LLM,RAG,API,BERT,6G
# RAGANYTHING_STRICT_RELATION_ENDPOINT_ENTITY_MATCH=true
# RAGANYTHING_RECOGNITION_TOP_K=20
# RAGANYTHING_RECOGNITION_PROMPT_MAX_TOKENS=65536
# RAGANYTHING_RECOGNITION_PROMPT_OUTPUT_MAX_TOKENS=8192
# RAGANYTHING_RECOGNITION_PROMPT_RESERVED_TOKENS=200
